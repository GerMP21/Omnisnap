# Injected scripts are pinned by SHA-256 (SHA256SUMS next to them). Line-ending
# conversion on checkout (core.autocrlf on Windows runners) would change their
# bytes, so git must leave them exactly as committed.
spikes/layout-diff/inject/*.js -text
assets/inject/*.js -text
assets/inject/SHA256SUMS -text
internal/groundtruth/inject/*.js -text
internal/groundtruth/inject/SHA256SUMS -text

# Planted fixtures are renderPage()'s exact bytes (export-planted.mjs --check).
testdata/planted/** -text
# Golden fixtures are the spike's exact output.
testdata/golden/** -text
# The install fixtures are signed: SHA512SUMS.asc covers the exact bytes, so a
# CRLF checkout on Windows would turn a valid signature into a hash mismatch.
testdata/install/** -text
# Go sources stay LF on every checkout: the Windows runner checks out with
# core.autocrlf=true, and gofmt reports every CRLF file as unformatted (the
# Windows lint job failed on all of them). eol=lf overrides core.autocrlf and
# implies text.
# Source: https://git-scm.com/docs/gitattributes#_eol
# Source: https://github.com/golangci/golangci-lint-action#how-to-use
*.go text eol=lf
