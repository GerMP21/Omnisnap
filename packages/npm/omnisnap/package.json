{
  "name": "omnisnap",
  "version": "0.2.0-rc.3",
  "description": "Cross-engine layout differences from one command; see exactly which elements render differently in every browser you have installed",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.js" }
  },
  "bin": { "omnisnap": "bin/omnisnap.js" },
  "files": ["index.js", "index.d.ts", "bin/", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "optionalDependencies": {
    "@omnisnap/linux-x64": "0.2.0-rc.3",
    "@omnisnap/linux-arm64": "0.2.0-rc.3",
    "@omnisnap/darwin-x64": "0.2.0-rc.3",
    "@omnisnap/darwin-arm64": "0.2.0-rc.3",
    "@omnisnap/win32-x64": "0.2.0-rc.3"
  },
  "scripts": { "test": "node --test \"test/*.test.mjs\"" },
  "license": "AGPL-3.0-or-later",
  "repository": { "type": "git", "url": "git+https://github.com/GerMP21/Omnisnap.git", "directory": "packages/npm/omnisnap" },
  "homepage": "https://omnisnap.org",
  "bugs": { "url": "https://github.com/GerMP21/Omnisnap/issues" }
}
