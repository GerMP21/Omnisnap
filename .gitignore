# Dependencies
node_modules/

# Spike outputs: screenshots, geometry captures, generated reports, datasets.
# models/ (the trained tree model, a few hundred KB) stays under version control.
spikes/*/out/
spikes/*/profiles/

# Golden real-site captures: third-party page content, local only
# (testdata/golden/README.md).
/testdata/golden/real/

# Go build and release output
/bin/
/dist/
*.test
coverage.out

# Python packaging (PyPI wrapper)
__pycache__/
*.py[cod]
.venv/
*.egg-info/
/build/
packages/*/build/
packages/*/dist/

# Staged release binaries (tools/release --stage): they are copied into the
# npm platform packages and the PyPI wheel at publish time, never committed.
packages/npm/platforms/*/bin/
packages/pypi/omnisnap/bin/

# Environment and secrets
.env
.env.*
!.env.example

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Claude Code per-user settings
.claude/settings.local.json

# Local CI logs and agent-loop state
ci-logs/
.ralph-loop.state.json

# The ground-truth crawl: third-party page content, local only (Task 73).
crawl/
crawl-out/
lab-out/

# Private product-strategy notes
docs/idea-refinement.md

# Built website and local wrangler dev state (tools/site/build.py, wrangler dev)
_site/
.wrangler/

# Local-only operator notes (setup credentials, runbooks)
docs/local/
dist-py/
